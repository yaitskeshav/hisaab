name: Expo CI/CD (staging)

on:
  push:
    branches:
      - staging

permissions:
  contents: write

concurrency:
  group: expo-staging
  cancel-in-progress: true

jobs:
  build_apk:
    name: Build APK + GitHub Release (only on [build])
    runs-on: ubuntu-latest

    if: contains(github.event.head_commit.message, '[build]')

    defaults:
      run:
        working-directory: frontend

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm
          cache-dependency-path: frontend/package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Setup EAS
        uses: expo/expo-github-action@v8
        with:
          eas-version: latest
          token: ${{ secrets.EXPO_TOKEN }}

      - name: Build APK (production profile) and capture artifact URL
        env:
          CI: "1"
          EXPO_PUBLIC_API_URL: ${{ secrets.EXPO_PUBLIC_API_URL }}
          EXPO_PUBLIC_SUPPORT_EMAIL: ${{ secrets.EXPO_PUBLIC_SUPPORT_EMAIL }}
        run: |
          eas build \
            -p android \
            --profile production \
            --non-interactive \
            --clear-cache \
            --wait \
            --json > eas-build.json

          echo "==== EAS BUILD JSON ===="
          cat eas-build.json

      - name: Download APK artifact
        run: |
          BUILD_URL=$(node -e "const b=require('./eas-build.json'); console.log(b.artifacts.buildUrl || b.artifacts.applicationArchiveUrl || '')")
          echo "Build URL: $BUILD_URL"

          if [ -z "$BUILD_URL" ]; then
            echo "Could not determine artifact URL from eas-build.json"
            exit 1
          fi

          curl -L "$BUILD_URL" -o app.apk

          if [ ! -f app.apk ]; then
            echo "APK download failed"
            exit 1
          fi

          ls -lah app.apk

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: staging-${{ github.run_number }}
          name: "Staging APK #${{ github.run_number }}"
          body: |
            Commit: ${{ github.sha }}
            Trigger: push to staging with [build] tag
            OTA: pushed to production channel
          files: |
            frontend/app.apk
