{
  "expo": {
    "name": "Hisaab",
    "slug": "hisaab",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ff954a4f-33c7-48de-9938-cd5bb998d8b6"
    },
    "scheme": "hisaab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/hisaab-logo-1024.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/hisaab-logo-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1f25"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hisaab.app",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "hisaab"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/hisaab-logo-1024.png",
        "backgroundColor": "#0F4C75"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.hisaab.app",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "hisaab"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3282B8"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ff954a4f-33c7-48de-9938-cd5bb998d8b6"
      }
    }
  }
}